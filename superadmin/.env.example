# Backend address WITHOUT /api, e.g. https://turavector.turacoz.com — or empty when this app and /api share one domain.
VITE_API_URL=
# Path this app is served from: empty locally; "admin" when it lives at https://turavector.turacoz.com/admin/
VITE_BASE_PATH=
# The main TuraVector site (for the "Go to TuraVector" link)
VITE_SITE_URL=
