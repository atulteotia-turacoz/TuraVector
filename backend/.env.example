# ---- TuraDome FastAPI backend ----
DEBUG=True
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (copy of the original tura_dome data)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tura_dome_new
DB_USER=atul
DB_PASSWORD=

# Public URLs
BACKEND_PUBLIC_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173
SUPERADMIN_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Uploaded files — shared with the original Django app (TuraDome/media)
MEDIA_ROOT=../../media
TIME_ZONE=Asia/Kolkata

# Email fallback when no active SMTP settings row exists (console|smtp)
EMAIL_BACKEND=console
DEFAULT_FROM_EMAIL=noreply@turadome.com
# Testing only: send every email to this address instead of the real recipient (empty in production)
EMAIL_REDIRECT_TO=

# OnlyOffice
ONLYOFFICE_DOCUMENT_SERVER_URL=https://officedom.turadome.com
ONLYOFFICE_EDITOR_JWT_SECRET=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_DISABLE_JWT=False
ENABLE_ONLYOFFICE_EDITOR=False
NGROK_BASE_URL=

# Microsoft Office 365 / OneDrive
MICROSOFT_CLIENT_ID=3fa81245-951b-4b0f-9e05-a7ac0bc5bdcf
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=1083284c-1e8a-4711-9a00-66dc6299c579
MICROSOFT_ONEDRIVE_USER_ID=tura.dome@turacoz.com

# Apryse / PDFTron WebViewer (served by the frontend from /webviewer/lib)
PDFTRON_ENABLED=True
PDFTRON_LICENSE_KEY=
PDFTRON_VERSION=8.10.0
PDFTRON_PATH=/webviewer/lib

ALLOW_DOCUMENT_DOWNLOAD=False
DOCUMENT_WATERMARK=True
DOCUMENT_PRINT_DISABLED=True

# Other Tura applications (dashboard-selection cards)
TURA_RESEARCH_ASSISTANT_URL=https://turaresearchassistant.turacoz.com/login
TURA_LMS_URL=https://turalms.turacoz.com/login/index.php
TURAGRAMMAR_URL=https://turagrammar.turacoz.com/
# Single sign-on into those apps (leave blank to keep the app's own login page).
# Each *_SSO_SECRET must equal TURADOME_SSO_SECRET in that app's .env (32+ random chars).
SSO_TICKET_TTL_SECONDS=60
TURA_RESEARCH_ASSISTANT_SSO_URL=
TURA_RESEARCH_ASSISTANT_SSO_SECRET=
TURAGRAMMAR_SSO_URL=
TURAGRAMMAR_SSO_SECRET=
# Moodle: install the auth_userkey plugin and create a web-service token for it
TURA_LMS_BASE_URL=https://turalms.turacoz.com
TURA_LMS_WS_TOKEN=

# Journal search
SPRINGER_API_KEY=
ELSEVIER_API_KEY=
PUBMED_API_KEY=
